    <li><a href="#panel">Features</a></li>
    <li><a href="#newsletter">Pricing</a></li>
    <li><a href="#newsletter">Docs</a></li>
  </ul>
  <a class="hidden md:block button-primary" href="#newsletter">Get Started Free</a>
  <button
    type="button"
    class="md:hidden flex items-center justify-center p-2 text-dark-surface"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg
      width="14"
      height="13"
      viewBox="0 0 14 13"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M1 1H12.9988M1 6.2506H12.9988M1 11.5012H12.9988"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </svg>
  </button>
  <div id="mobile-menu" class="absolute left-0 right-0 top-full bg-surface border-b border-border-gray-neutral px-6 pb-4 pt-2 shadow-md md:hidden" hidden>
    <ul class="flex flex-col gap-3 font-geist text-secondary">
