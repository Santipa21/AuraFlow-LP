---
import saraLin from '../assets/sara-lin.png';
import marcusVance from '../assets/marcus-vance.png';
import elenaRostova from '../assets/elena-rostova.png';
---

<section
  class="bg-gray-100 flex flex-col items-center gap-6 px-6 py-12
md:gap-8 md:px-12 md:py-16
xl:gap-12 xl:py-20 xl:px-30"
>
  <div class="flex flex-col items-center gap-3">
    <h3 class="font-syne font-bold text-4xl text-dark-surface">
      Trusted by teams
    </h3>
    <p class="font-geist text-base text-secondary">
      Nimble cohorts to global telecom stacks.
    </p>
  </div>
  <div
    class="grid grid-cols-1 gap-4
  md:gap-6 md:grid-cols-2
  xl:gap-8 xl:grid-cols-3"
  >
    <article
      class="grid grid-cols-1 gap-3 p-4 rounded-lg bg-surface
    md:gap-4 md:p-5
    xl:gap-5 xl:p-6 xl:border xl:border-border-gray-neutral"
    >
      <p
        class="font-geist text-xs text-secondary
      md:text-sm
      xl:text-base"
      >
        "AuraFlow transformed how we distribute workloads. Edge latency
        plummeted and platform stability became a non-issue."
      </p>
      <div class="flex gap-2 items-center">
        <figure>
          <img
            class="rounded-full w-7
        md:w-8
        xl:w-10"
            src={saraLin.src}
            alt="Sarah Lin"
          />
        </figure>
        <div>
          <p
            class="font-geist font-bold text-xs text-dark-surface
            xl:text-sm"
          >
            Sarah Lin
          </p>
          <p class="hidden
          xl:block font-geist text-xs text-secondary">VPE, CloudScale</p>
        </div>
      </div>
    </article>
    <article
      class="grid grid-cols-1 gap-3 p-4 rounded-lg bg-surface
    md:gap-4 md:p-5
    xl:gap-5 xl:p-6 xl:border xl:border-border-gray-neutral"
    >
      <p
        class="font-geist text-xs text-secondary
      md:text-sm
      xl:text-base"
      >
        "The isolated enclaves gave our compliance team peace of mind. Truly
        production-grade architecture out of the box."
      </p>
      <div class="flex gap-2 items-center">
        <figure>
          <img
            class="rounded-full w-7
        md:w-8
        xl:w-10"
            src={marcusVance.src}
            alt="Marcus Vance"
          />
        </figure>
        <div>
          <p
            class="font-geist font-bold text-xs text-dark-surface
            xl:text-sm"
          >
            Marcus Vance
          </p>
          <p class="hidden
          xl:block font-geist text-xs text-secondary">Principal Architect, Nexus</p>
        </div>
      </div>
    </article>
    <article
      class="grid grid-cols-1 gap-3 p-4 rounded-lg bg-surface
    md:col-span-2 md:gap-4 md:p-5
    xl:col-span-1 xl:gap-5 xl:p-6 xl:border xl:border-border-gray-neutral"
    >
      <p
        class="font-geist text-xs text-secondary
      md:text-sm
      xl:text--base"
      >
        "Global sync database engine resolved our cross-region consistency
        issues. Our transaction lag is effectively zero."
      </p>
      <div class="flex gap-2 items-center">
        <figure>
          <img
            class="rounded-full w-7
        md:w-8
        xl:w-10"
            src={elenaRostova.src}
            alt="Elena Rostova"
          />
        </figure>
        <div>
          <p
            class="font-geist font-bold text-xs text-dark-surface
            xl:text-sm"
          >
            Elena Rostova
          </p>
          <p class="hidden
          xl:block font-geist text-xs text-secondary">CTO, FinStream</p>
        </div>
      </div>
    </article>
  </div>
</section>
