---
import { Image } from 'astro:assets';
import gallery1 from '../assets/gallery-1.jpeg';
import gallery2 from '../assets/gallery-2.jpeg';
import gallery3 from '../assets/gallery-3.jpg';
import gallery4 from '../assets/gallery-4.jpg';
import gallery5 from '../assets/gallery-5.jpg';
import gallery6 from '../assets/gallery-6.jpg';
---

<section class="bg-gray-100 py-12 px-6 gap-6 flex flex-col items-center
md:py-16 md:px-12 md:gap-8
xl:py-20 xl:px-30 xl:gap-12">
  <div class="flex flex-col items-center gap-3">
    <h2 class="font-syne font-bold text-4xl text-dark-surface text-center">Observe infrastructure</h2>
    <p class="font-geist  text-base text-secondary">Photographic logging of our cooling centers.</p>
  </div>
  <div class="grid grid-cols-1 gap-4
  md:grid-cols-2
  xl:grid-cols-3">
    <figure class="relative
    md:order-1
    xl:order-1">
      <Image class="rounded-lg max-h-40 w-dvw md:max-h-50 xl:max-h-80 object-cover" src={gallery1} alt="Platform Map" />
      <figcaption class="absolute left-3 bottom-3 py-1 px-2 rounded-sm text-surface font-geist font-semibold text-xs bg-dark-surface/75">Platform Map</figcaption>
    </figure>
    <figure class="relative
    md:order-3
    xl:order-4">
      <Image class="rounded-lg max-h-40 w-dvw md:max-h-50 xl:max-h-105 object-cover" src={gallery2} alt="Edge Node Alpha" />
      <figcaption class="absolute left-3 bottom-3 py-1 px-2 rounded-sm text-surface font-geist font-semibold text-xs bg-dark-surface/75">Edge Node Alpha</figcaption>
    </figure>
    <figure class="relative
    md:order-5
    xl:order-2 xl:max-h-65">
      <Image class="rounded-lg max-h-40 w-dvw md:max-h-50 xl:max-h-65 object-cover" src={gallery3} alt="Realtime Telemetry" />
      <figcaption class="absolute left-3 bottom-3 py-1 px-2 rounded-sm text-surface font-geist font-semibold text-xs bg-dark-surface/75">Realtime Telemetry</figcaption>
    </figure>
    <figure class="relative
    md:order-2
    xl:order-5 xl:max-h-95">
      <Image class="rounded-lg max-h-40 w-dvw md:max-h-50 xl:max-h-95 object-cover" src={gallery4} alt="HQ Operations" />
      <figcaption class="absolute left-3 bottom-3 py-1 px-2 rounded-sm text-surface font-geist font-semibold text-xs bg-dark-surface/75">HQ Operations</figcaption>
    </figure>
      <figure class="hidden relative
      md:grid md:order-4
      xl:order-3">
        <Image class="rounded-lg md:max-h-50 w-dvw xl:max-h-80 object-cover" src={gallery5} alt="Developer Station" />
        <figcaption class="absolute left-3 bottom-3 py-1 px-2 rounded-sm text-surface font-geist font-semibold text-xs bg-dark-surface/75">Developer Station</figcaption>
      </figure>
      <figure class="hidden relative
      md:grid md:order-6
      xl:order-6 xl:max-h-95">
        <Image class="rounded-lg md:min-h-50 w-dvw xl:min-h-96 object-cover" src={gallery6} alt="Telemetry Stream" />
        <figcaption class="absolute left-3 bottom-3 py-1 px-2 rounded-sm text-surface font-geist font-semibold text-xs bg-dark-surface/75">Telemetry Stream</figcaption>
      </figure>
  </div>
</section>
