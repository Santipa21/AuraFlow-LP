<section class="bg-[linear-gradient(to_right,#312E81_0%,#0F172A_100%)] flex flex-col items-center gap-5 px-6 py-12
md:gap-6 md:px-12 md:py-16
xl:gap-8 xl:px-30 xl:py-20">
  <div class="flex flex-col items-center gap-2
  xl:gap-3">
    <h2 class="font-syne font-bold text-2xl text-surface
    md:text-3xl
    xl:text-4xl">Deploy your cluster.</h2>
    <p class="font-geist text-xs text-[#94A3B8]
    md:text-sm
    xl:text-base">Sign up to our developer channel for direct telemetry.</p>
  </div>
    <form class="grid grid-cols-1 gap-3 w-full
    md:grid-cols-4 md:w-fit
    xl:gap-4" action="#" method="post">
      <label for="email" class="sr-only">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        class="px-3 py-2.5 rounded-[8px] bg-transparent border border-[#94A3B8] placeholder-[#94A3B8] font-geist text-xs text-surface
        md:px-3.5 md:col-span-3 md:text-sm
        xl:px-4 xl:py-3"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <button type="submit" class="px-4 py-3 rounded-[8px] bg-indigo text-surface font-geist font-semibold text-xs cursor-pointer
      md:px-5 md:text-sm
      xl:px-6 xl:py-3.5">Subscribe</button>
    </form>
</section>
